 * SPDX-License-Identifier: LicenseRef-Nordic-5-Clause
 *
 * Companion UART to nRF9151 DK UART1 (cross-wire TX/RX, common GND).
 *
 * UARTE21 on P1.13 / P1.14 (Nordic DK test pinout) so UART20 console can stay on
 * P1.16 / P1.17 → J-Link VCOM (Serial Port 1) for app logs while companion runs.
 * UARTE21 must use port P1 or P3 (not P2).
 *
 * nRF54 TX: P1.13 (also Nordic expansion header D5). RX: P1.14 (9151 ACK, optional).
 */

/ {
	aliases {
		companion-uart = &uart21;
	};
};

&pinctrl {
	uart21_default: uart21_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 13)>,
				<NRF_PSEL(UART_RX, 1, 14)>;
			bias-pull-up;
		};
	};

	uart21_sleep: uart21_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 13)>,
				<NRF_PSEL(UART_RX, 1, 14)>;
			low-power-enable;
		};
	};
};

&uart21 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart21_default>;
	pinctrl-1 = <&uart21_sleep>;
	pinctrl-names = "default", "sleep";
};
